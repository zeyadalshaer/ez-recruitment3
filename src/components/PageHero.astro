---
import Img from './Img.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  crumb?: { label: string; href?: string }[];
}
const { eyebrow, title, intro, image, imageAlt = '', crumb = [] } = Astro.props;
---
<section class="page-hero">
  {image && (
    <div class="page-hero__art" aria-hidden="true">
      <Img src={image} alt={imageAlt} loading="eager" sizes="60vw" />
    </div>
  )}
  <div class="container page-hero__inner">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {crumb.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow eyebrow--light">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="page-hero__intro">{intro}</p>}
  </div>
</section>
