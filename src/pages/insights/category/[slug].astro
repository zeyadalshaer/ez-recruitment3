---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getCategories, pages } from '../../../lib/site';

export async function getStaticPaths() {
  const cats = await getCategories();
  return cats.map((c) => ({ params: { slug: c.id }, props: { cat: c } }));
}

const { cat } = Astro.props;
const p = pages.insights;
---
<Layout title={`${cat.title} | ${p.title}`} description={cat.description ?? p.description}>
  <PageHero
    eyebrow="Insights"
    title={cat.title}
    intro={cat.description}
    crumb={[{ label: p.title, href: '/insights/' }, { label: cat.title }]}
  />
  <section class="section section--tight">
    <div class="container">
      <BlogIndex category={cat.id} showFeatured={false} />
    </div>
  </section>
  <CtaBand />
</Layout>
